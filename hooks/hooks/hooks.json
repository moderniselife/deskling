{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\"", "async": true, "timeout": 10}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\" sync", "timeout": 8}]}
    ],
    "Notification": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\"", "async": true, "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\" sync", "timeout": 8}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\"", "async": true, "timeout": 5}]}
    ],
    "PreToolUse": [
      {"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\" wait", "timeout": 130}]},
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\" live", "async": true, "timeout": 5}]}
    ],
    "PermissionRequest": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\" wait", "timeout": 130}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\"", "async": true, "timeout": 5}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\"", "async": true, "timeout": 5}]}
    ],
    "PostToolUse": [
      {"matcher": "SendUserMessage", "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/deskling-hook.sh\"", "async": true, "timeout": 5}]}
    ]
  }
}
